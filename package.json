{
  "name": "rust-path",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@11.1.3",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty",
    "test": "vitest run",
    "content:validate": "node scripts/course-content.mjs validate content/borrowed-text.course.json --samples content/course-samples.json",
    "content:validate-public": "node scripts/validate-public-course-manifest.mjs",
    "content:check-samples": "node scripts/validate-course-samples.mjs validate content/course-samples.json",
    "lint": "eslint src",
    "format:check": "prettier --check src scripts content/*.json schemas/*.json *.json *.ts *.js .github/workflows/*.yml",
    "check:frontend": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "preview": "vite preview",
    "test:watch": "vitest",
    "check": "pnpm check:frontend",
    "format": "prettier --write src scripts content/*.json schemas/*.json *.json *.ts *.js .github/workflows/*.yml"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "22.18.10",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "9.39.1",
    "eslint-plugin-react-hooks": "5.2.0",
    "jsdom": "26.1.0",
    "prettier": "3.6.2",
    "tailwindcss": "^4.0.0",
    "typescript": "~5.7.2",
    "typescript-eslint": "8.46.1",
    "vite": "^6.4.4",
    "vitest": "3.2.4"
  },
  "engines": {
    "node": ">=22.19.0 <23"
  }
}
