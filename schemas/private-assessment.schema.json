{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rust-backend-training.local/schemas/private-assessment.schema.json",
  "title": "Rust Academy private assessment pack",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "course_id",
    "version",
    "assessments",
    "resources"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "course_id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
    },
    "assessments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "exercise_id", "reference_answer", "private_tests"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "exercise_id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "reference_answer": { "type": "string", "minLength": 1 },
          "private_tests": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "resources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "path", "media_type"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "path": { "type": "string", "minLength": 1 },
          "media_type": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
