OIDC_ENABLED=false
OIDC_ISSUER_URL=https://identity.example.com/
OIDC_CLIENT_ID=rust-path-web
OIDC_CLIENT_SECRET=replace-with-a-secret-from-the-provider
OIDC_REDIRECT_URL=http://localhost:3000/api/v1/auth/oidc/callback
APP_ORIGIN=http://localhost:5173
API_BIND_ADDRESS=127.0.0.1:3000
COOKIE_SECURE=false
DATABASE_URL=sqlite://rust-path.db
SMTP_HOST=smtp.example.test
SMTP_PORT=587
SMTP_USERNAME=replace-with-smtp-username
SMTP_PASSWORD=replace-with-local-smtp-password
SMTP_FROM="Rust Path <noreply@example.test>"
SMTP_TLS=starttls_required
